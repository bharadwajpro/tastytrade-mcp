# Copy to .env and fill in. NEVER commit .env.

# === Credentials (REQUIRED) ===
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# === Environment ===
TT_ENVIRONMENT=production            # production | sandbox
# TT_API_BASE_URL=
# TT_ACCOUNT_STREAMER_URL=

# === Accounts ===
TT_ACCOUNT_NUMBER=
# TT_ACCOUNT_NUMBERS=5WX1,5WX2

# === Headers ===
TT_USER_AGENT=tastytrade-mcp/0.1
# TT_API_VERSION=

# === DxLink token cache (absolute path OUTSIDE the repo; empty = disabled) ===
# TT_DXLINK_CACHE_PATH=/var/lib/tastytrade-mcp/dxlink.token

# === Safety gates (default = read + dry-run only) ===
TT_READ_ONLY=true
TT_ENABLE_TRADING=false
TT_ENABLE_WATCHLIST_WRITES=false
TT_ENABLE_QUOTE_ALERTS=false

# === Transport ===
MCP_TRANSPORT=http                   # http | stdio
PORT=8080
SERVER_URL=                          # REQUIRED for http; public https URL of THIS server
MCP_AUTH_TOKEN=                      # bearer guarding /mcp; blank => /mcp rejects all requests
OAUTH_CLIENT_ID=                     # reserved: loaded by config, not yet wired into the gateway
OAUTH_CLIENT_SECRET=                 # reserved: loaded by config, not yet wired into the gateway

# === Timeouts ===
TT_TOOL_TIMEOUT=30s
TT_STALE_QUOTE_THRESHOLD=5s
