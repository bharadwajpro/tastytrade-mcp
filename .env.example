# Copy to .env and fill in. NEVER commit .env.

# === Credentials (REQUIRED) ===
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# === Environment ===
TT_ENVIRONMENT=production            # production | sandbox
# TT_API_BASE_URL=
# TT_ACCOUNT_STREAMER_URL=

# === Accounts ===
TT_ACCOUNT_NUMBER=
# TT_ACCOUNT_NUMBERS=5WX1,5WX2

# === Headers ===
TT_USER_AGENT=tastytrade-mcp/0.1
# TT_API_VERSION=

# === Safety gates (default = read + dry-run only) ===
TT_READ_ONLY=true
TT_ENABLE_TRADING=false
TT_ENABLE_WATCHLIST_WRITES=false
TT_ENABLE_QUOTE_ALERTS=false

# === Transport ===
MCP_TRANSPORT=http                   # http | stdio
PORT=8080
SERVER_URL=                          # REQUIRED for http; public https URL of THIS server
# MCP HTTP OAuth (NOT tastytrade): fixed client_id + client_secret the MCP client sends to
# /oauth/token. No dynamic registration — any other pair is rejected. Issues a 1h access
# token plus a rotating refresh token (single-use, in-memory only; server restart forces
# re-auth). Blank id/secret => /oauth/token rejects all clients and /mcp is unreachable.
# Generate (alphanumeric):
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo   # OAUTH_CLIENT_ID
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64; echo   # OAUTH_CLIENT_SECRET
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# === Timeouts ===
TT_TOOL_TIMEOUT=30s
TT_STALE_QUOTE_THRESHOLD=5s
